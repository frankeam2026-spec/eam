{
  "name": "equipment-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" *.json vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" *.json vite.config.ts",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "element-plus": "2.14.7",
    "pinia": "3.0.4",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "vue-tsc": "2.2.10"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
